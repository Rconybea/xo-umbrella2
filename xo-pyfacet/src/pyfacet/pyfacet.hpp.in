/* @file pyfacet.hpp
 *
 * automatically generated from src/pyfacet/pyfacet.hpp.in
 * see src/pyfacet/CMakeLists.txt
 */

/* The module's python name is xo.facet, but its init symbol is NOT: CPython
 * looks for PyInit_<last dotted component>, so PYBIND11_MODULE() takes the
 * bare name.  The `xo.` prefix comes from the directory the .so is emitted
 * into -- see xo_pybind11_library() in xo-cmake.
 *
 * example:
 *   PYBIND11_MODULE(PYFACET_MODULE_NAME(), m) { ... }
 */
#define PYFACET_MODULE_NAME() @SELF_MODULE@

/* the qualified name, for importing.
 * example:
 *   py::module_::import(PYFACET_MODULE_NAME_STR)
 */
#define PYFACET_MODULE_NAME_STR "@SELF_QUALNAME@"

/* example:
 *   PYFACET_IMPORT_MODULE()
 * replaces
 *   py::module_::import("xo.facet")
 */
#define PYFACET_IMPORT_MODULE() py::module_::import("@SELF_QUALNAME@")

/* end pyfacet.hpp */
