{
    mode: "facet",
    output_cpp_dir: "src/printable2",
    output_hpp_dir: "include/xo/printable2",
    output_impl_subdir: "detail",
    includes: ["<xo/ppsink/PpSink.hpp>"],
    // extra includes in Printable.hpp
    //
    // NB <xo/alloc2/Allocator.hpp> was hand-added to the GENERATED Printable.hpp
    // by b1add3bb ("move Collector facet gc/ -> alloc2/ for levelling") and so
    // was silently dropped by the next regeneration.  It belongs here instead.
    user_hpp_includes: ["\"detail/pretty_Printable.hpp\"",
                        "<xo/alloc2/Allocator.hpp>"],
    namespace1: "xo",
    namespace2: "print",
    // text after includes, before APrintable
    pretext: [ "// {pretext} here" ],
    facet: "Printable",
    detail_subdir: "detail",
    brief: "pretty-printable objects",
    using_doxygen: true,
    doc: [
        "Trait for data types that support pretty-printing"
    ],
    types: [
        // using PpSink = xo::pp::PpSink
        {
            name: "PpSink",
            doc:  ["single-pass pretty-printing sink; see xo-ppsink"],
            definition: "xo::pp::PpSink",
        },
    ],
    const_methods: [
        // void pretty(PpSink & sink) const
        {
            name: "pretty",
            doc: [
                "Pretty-printing support for this object.",
                "Single-pass: render into @p sink.  A nested object",
                "participates in the enclosing structure's line breaking,",
                "where the deprecated two-pass protocol could not.",
                "See [xo-ppsink/xo/ppsink/PpSink.hpp]",
            ],
            return_type: "void",
            args: [
                {type: "PpSink &", name: "sink"},
            ],
            const: true,
        },
    ],
    nonconst_methods: [],
    router_facet_explicit_content: [],
}
