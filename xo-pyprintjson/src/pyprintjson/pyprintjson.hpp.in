/* @file pyprintjson.hpp
 *
 * automatically generated from src/pyprintjson/pyprintjson.hpp.in
 * see src/pyprintjson/CMakeLists.txt
 */

/* The module's python name is xo.printjson, but its init symbol is NOT: CPython
 * looks for PyInit_<last dotted component>, so PYBIND11_MODULE() takes the
 * bare name.  The `xo.` prefix comes from the directory the .so is emitted
 * into -- see xo_pybind11_library() in xo-cmake.
 *
 * example:
 *   PYBIND11_MODULE(PYPRINTJSON_MODULE_NAME(), m) { ... }
 */
#define PYPRINTJSON_MODULE_NAME() @SELF_MODULE@

/* the qualified name, for importing.
 * example:
 *   py::module_::import(PYPRINTJSON_MODULE_NAME_STR)
 */
#define PYPRINTJSON_MODULE_NAME_STR "@SELF_QUALNAME@"

/* example:
 *   PYPRINTJSON_IMPORT_MODULE()
 * replaces
 *   py::module_::import("xo.printjson")
 */
#define PYPRINTJSON_IMPORT_MODULE() py::module_::import("@SELF_QUALNAME@")

/* end pyprintjson.hpp */
