/* @file pyreflect.hpp
 *
 * automatically generated from src/pyreflect/pyreflect.hpp.in
 * see src/pyreflect/CMakeLists.txt
 */

/* The module's python name is xo.reflect, but its init symbol is NOT: CPython
 * looks for PyInit_<last dotted component>, so PYBIND11_MODULE() takes the
 * bare name.  The `xo.` prefix comes from the directory the .so is emitted
 * into -- see xo_pybind11_library() in xo-cmake.
 *
 * example:
 *   PYBIND11_MODULE(PYREFLECT_MODULE_NAME(), m) { ... }
 */
#define PYREFLECT_MODULE_NAME() @SELF_MODULE@

/* the qualified name, for importing.
 * example:
 *   py::module_::import(PYREFLECT_MODULE_NAME_STR)
 */
#define PYREFLECT_MODULE_NAME_STR "@SELF_QUALNAME@"

/* example:
 *   PYREFLECT_IMPORT_MODULE()
 * replaces
 *   py::module_::import("xo.reflect")
 */
#define PYREFLECT_IMPORT_MODULE() py::module_::import("@SELF_QUALNAME@")

/* end pyreflect.hpp */
