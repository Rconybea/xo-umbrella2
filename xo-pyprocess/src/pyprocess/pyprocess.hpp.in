/* The module's python name is xo.process, but its init symbol is NOT: CPython
 * looks for PyInit_<last dotted component>, so PYBIND11_MODULE() takes the
 * bare name.  The `xo.` prefix comes from the directory the .so is emitted
 * into -- see xo_pybind11_library() in xo-cmake.
 *
 * example:
 *   PYBIND11_MODULE(PYPROCESS_MODULE_NAME(), m) { ... }
 */
#define PYPROCESS_MODULE_NAME() @SELF_MODULE@

/* the qualified name, for importing.
 * example:
 *   py::module_::import(PYPROCESS_MODULE_NAME_STR)
 */
#define PYPROCESS_MODULE_NAME_STR "@SELF_QUALNAME@"

/* example:
 *   PYPROCESS_IMPORT_MODULE()
 * replaces
 *   py::module_::import("xo.process")
 */
#define PYPROCESS_IMPORT_MODULE() py::module_::import("@SELF_QUALNAME@")

/* end pyprocess.hpp */
