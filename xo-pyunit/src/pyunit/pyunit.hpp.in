/* @file pyunit.hpp
 *
 * automatically generated from src/pyunit/pyunit.hpp.in
 * see src/pyunit/CMakeLists.txt
 */

/* The module's python name is xo.unit, but its init symbol is NOT: CPython
 * looks for PyInit_<last dotted component>, so PYBIND11_MODULE() takes the
 * bare name.  The `xo.` prefix comes from the directory the .so is emitted
 * into -- see xo_pybind11_library() in xo-cmake.
 *
 * example:
 *   PYBIND11_MODULE(PYUNIT_MODULE_NAME(), m) { ... }
 */
#define PYUNIT_MODULE_NAME() @SELF_MODULE@

/* the qualified name, for importing.
 * example:
 *   py::module_::import(PYUNIT_MODULE_NAME_STR)
 */
#define PYUNIT_MODULE_NAME_STR "@SELF_QUALNAME@"

/* example:
 *   PYUNIT_IMPORT_MODULE()
 * replaces
 *   py::module_::import("xo.unit")
 */
#define PYUNIT_IMPORT_MODULE() py::module_::import("@SELF_QUALNAME@")

/* end pyunit.hpp */
