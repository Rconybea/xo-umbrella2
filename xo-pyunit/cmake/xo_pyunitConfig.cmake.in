@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# NB hand-maintained, unlike most xo subsystems: xo_export_cmake_config() builds
# @XO_FIND_DEPENDENCY_BLOCK@ from the target named ${PROJECT_NAME}, but this
# subsystem's library target is `pyunit` while the project is `xo_pyunit`, so the
# generated block comes out empty.  Keep in step with
# xo-pyunit/src/pyunit/CMakeLists.txt by hand until those names agree.
find_dependency(xo_pyutil)
find_dependency(xo_unit)
find_dependency(refcnt)
find_dependency(xo_ppsink)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Share.cmake")
check_required_components("@PROJECT_NAME@")
