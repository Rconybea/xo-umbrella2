/* The module's python name is xo.simulator, but its init symbol is NOT: CPython
 * looks for PyInit_<last dotted component>, so PYBIND11_MODULE() takes the
 * bare name.  The `xo.` prefix comes from the directory the .so is emitted
 * into -- see xo_pybind11_library() in xo-cmake.
 *
 * example:
 *   PYBIND11_MODULE(PYSIMULATOR_MODULE_NAME(), m) { ... }
 */
#define PYSIMULATOR_MODULE_NAME() @SELF_MODULE@

/* the qualified name, for importing.
 * example:
 *   py::module_::import(PYSIMULATOR_MODULE_NAME_STR)
 */
#define PYSIMULATOR_MODULE_NAME_STR "@SELF_QUALNAME@"

/* example:
 *   PYSIMULATOR_IMPORT_MODULE()
 * replaces
 *   py::module_::import("xo.simulator")
 */
#define PYSIMULATOR_IMPORT_MODULE() py::module_::import("@SELF_QUALNAME@")

/* end pysimulator.hpp */
