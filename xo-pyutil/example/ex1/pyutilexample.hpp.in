/* example:
 *   XO_PYUTILEXAMPLE_IMPORT_MODULE()
 * replaces
 *   py::module_::import("xo.utilexample")
 */
#define XO_PYUTILEXAMPLE_IMPORT_MODULE() py::module_::import("@SELF_QUALNAME@")

