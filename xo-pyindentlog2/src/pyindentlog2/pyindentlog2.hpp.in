/* The module's python name is xo.indentlog2, but its init symbol is NOT: CPython
 * looks for PyInit_<last dotted component>, so PYBIND11_MODULE() takes the
 * bare name.  The `xo.` prefix comes from the directory the .so is emitted
 * into -- see xo_pybind11_library() in xo-cmake.
 *
 * example:
 *   PYBIND11_MODULE(PYINDENTLOG2_MODULE_NAME(), m) { ... }
 */
#define PYINDENTLOG2_MODULE_NAME() @SELF_MODULE@

/* the qualified name, for importing.
 * example:
 *   py::module_::import(PYINDENTLOG2_MODULE_NAME_STR)
 */
#define PYINDENTLOG2_MODULE_NAME_STR "@SELF_QUALNAME@"

/* example:
 *   PYINDENTLOG2_IMPORT_MODULE()
 * replaces
 *   py::module_::import("xo.indentlog2")
 */
#define PYINDENTLOG2_IMPORT_MODULE() py::module_::import("@SELF_QUALNAME@")

/* end pyindentlog2.hpp */
