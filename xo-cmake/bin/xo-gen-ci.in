#!/usr/bin/env python3
"""xo-gen-ci - generate the per-subsystem body of a forgejo cmake pipeline.

The repetitive middle of .forgejo/workflows/ci-cmake.yaml is one identical step
per subsystem, in build order.  Maintaining it by hand has drifted: as of
2026-09-07 the workflow named 41 subsystems where subsystem-list has 70.

Membership and order come from the same file xo-build reads, so a subsystem
added there is built by CI without a second edit.

Emits to stdout.  Sole variation is the subsystem name -- the step uses
`xo-build --utest`, not a bare `ctest`, so a subsystem with no tests needs no
special case (it reports 'no-tests' rather than passing vacuously).
"""

import argparse
import sys

STEP = """      - name: build {sub}
        run: |
          echo "::group::{sub} configure"
          xo-build --configure --with-utests --with-examples {sub}
          echo "::endgroup::"

          echo "::group::{sub} build"
          xo-build --build {sub}
          echo "::endgroup::"

          echo "::group::{sub} utest"
          xo-build --utest {sub}
          echo "::endgroup::"

          echo "::group::{sub} install"
          xo-build --install {sub}
          echo "::endgroup::"
"""


def subsystems(path, exclude):
    out = []
    with open(path) as f:
        for line in f:
            name = line.strip()
            if name and not name.startswith("#") and name not in exclude:
                out.append(name)
    return out


def main():
    p = argparse.ArgumentParser()
    p.add_argument("subsystem_list")
    p.add_argument("--exclude", action="append", default=[],
                   help="subsystem to omit (e.g. the xo-cmake bootstrap)")
    args = p.parse_args()

    subs = subsystems(args.subsystem_list, set(args.exclude))

    print("      # ---- GENERATED by xo-gen-ci from etc/xo/subsystem-list ----")
    print("      # Do not edit these steps by hand; regenerate instead.")
    print()
    for i, sub in enumerate(subs):
        if i:
            print()
        print(STEP.format(sub=sub), end="")
    print()
    print("      # ---- end GENERATED ----")
    return 0


if __name__ == "__main__":
    sys.exit(main())
