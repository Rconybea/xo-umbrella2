#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<EOF
$0 [-u|--usage|-h|--help]
    [--list] [-n|--dry-run] [--xoname=NAME]
    [--repo
     |--add-umbrella-remote
     |--split-umbrella-remote
     |--pull-umbrella-remote
     |--push-umbrella-remote]
    [--clone|--clobber|--configure|--build|--install]
    [--with-examples] [--with-utests] [--with-asm] [--debug-build]
    [--with-opengl=GLFLAG] [--with-vulkan=VKFLAG]
    [-S=SOURCEDIR] [-B=BUILDDIR] [-j N|--jobs=N]
    [-q|--quiet] [-k|--keep-going]
    [--sweep]
    [--all | [--with-deps] NAME ...]
    [-- CMAKE_ARGS]
EOF
}

help() {
    usage

    cat <<EOF

fetch and/or build xo component libraries

Options:
  -u | --usage            brief help message
  -h | --help             this help message
  --list                  list known xo libraries
  -n | --dry-run          dry-run: don't actually invoke state-changing commands
  -q | --quiet            quiet on success, loud on failure.  Buffers each
                          phase's output and prints one line per subsystem;
                          on failure prints everything that was buffered and
                          exits non-zero.  Never hides an error -- unlike
                          redirecting to /dev/null, which also discards the
                          diagnostics and makes a failed build look identical
                          to a successful one.
  -k | --keep-going       do not stop at the first failure; carry on with work
                          that does not depend on it, then report a summary and
                          exit non-zero.  As in make(1).
                          For --configure/--build/--install, everything
                          downstream of a failed subsystem is SKIPPED, since it
                          cannot build against a broken dependency (downstream
                          set via xo-deps --users-of).
                          For --utest there is no skipping: a dependent's tests
                          are independent of a failed subsystem's tests and are
                          still worth running.  This is what makes a whole-tree
                          test sweep possible when one subsystem fails
                          persistently.
  --xoname=NAME           operate on xo subsystem NAME
  --all                   operate on every subsystem from --list, in dependency
                          order (bottom-up), excluding the xo-cmake bootstrap.
                          The chosen operations (e.g. --configure --build --utest
                          --install) run for each subsystem before moving to the
                          next, so a whole-umbrella cmake build is one command.
                          Multiple NAMEs may also be given explicitly instead.
  --with-deps             expand the named subsystem(s) to their transitive
                          dependency closure (using subsystem-edges) and operate
                          on the whole closure in bottom-up order.  Use this to
                          build a subsystem from scratch (e.g. in a fresh docker
                          container) where its dependencies are not yet installed.
                          Ignored with --all.
  --sweep                 whole-tree verification, in two stages:
                            1. --configure --build --install, with
                               --with-utests and --with-examples
                            2. --utest
                          both with -q and -k, and with --all unless NAMEs are
                          given.  Two invocations rather than one, because
                          xo-build runs every chosen phase for a subsystem
                          before moving to the next -- so a single pass would
                          test a subsystem before its dependents were built.
                          Stage 2 runs even if stage 1 failed (that is what -k
                          is for); the closing banner names the stage that
                          failed and the exit status is non-zero if either did.
                          Exists so the flags above stop being something anyone
                          has to remember: --with-examples in particular, whose
                          absence reports green on a tree that does not build.
                          Also adds --with-vulkan=ON when this host has vulkan,
                          since xo-imgui's ex3/ex4/ex4a are gated on it and are
                          otherwise skipped without comment.  An explicit
                          --with-vulkan=VKFLAG overrides that, either way.
  -- CMAKE_ARGS           everything after -- is appended verbatim to the cmake
                          CONFIGURE command line, and nowhere else.  Same
                          convention as xo-reconfigure.  Combines with --sweep,
                          which forwards them to its configure stage:
                            xo-build --sweep -- -DCMAKE_CXX_FLAGS=-DXO_FOO
                          They go last, so they override the flags xo-build sets
                          itself (cmake takes the final -D for a variable).
                          An error, not a no-op, without --configure or --sweep:
                          a silently dropped flag yields a build that looks like
                          the one you asked for and is not.
                          NB THEY STICK, deliberately: caching is how cmake lets
                          you state a variable once.  A later xo-build
                          --configure without -- does not clear what it never
                          sets.  To drop them, either name the variable again
                          with an empty value (-- '-DCMAKE_CXX_FLAGS=') or use
                          --clobber, which discards the cache wholesale.  An
                          experimental flag that outlives the experiment is the
                          same failure as a stale SDL2 cache: the build is not
                          the one the source implies.
  --clone                 git clone xo library NAME in current directory
  --configure             run cmake for xo library NAME in immediate subdir
                          Will use NAME/.build as build directory
  --build                 run cmake build for xo library NAME in immediate subdir
  --build-docs            build documentation for xo library NAME in immediate subdir
  --utest                 run unit tests for xo library NAME
  --install               run cmake install for xo library NAME in immediate subdir
  --clobber               discard the build directory.  Runs FIRST, before any
                          other phase, so cmake starts from an empty cache:
                            xo-build --clobber --configure --build NAME
                          Alone, it is just "delete the build directory".
                          Cache stickiness is a cmake feature -- variables
                          persist so you need not restate them -- and discarding
                          the cache is the supported way to opt out of it, and
                          what you want when you do not know the name of every
                          variable a past invocation set.  Same name and meaning
                          as xo-reconfigure --clobber.
                          Replaced --realclean (removed 2026-08-10), which did
                          the same thing but ran LAST, so
                          --realclean --configure --build configured, built, and
                          then deleted the result.  Nothing in the tree used it.

  -S=SOURCEDIR            override path/to/source
  -B=BUILDDIR             override path/to/build
  -j N | --jobs=N         build with N parallel compile jobs (cmake --build -j N).
                          Default: min(nproc, RAM/~1.5GB), to avoid OOM-killing
                          the compiler on memory-limited machines.  Takes
                          precedence over the XO_BUILD_JOBS environment variable.

  --with-examples         in configure step, set -DXO_ENABLE_EXAMPLES=1
  --with-utests           in configure step, set -DENABLE_TESTING=1
  --with-asm              in configure step, set -DXO_ENABLE_ASM=1
  --debug-build           in configure step, set -DCMAKE_BUILD_TYPE=Debug
  --with-opengl=GLFLAG    in configure step, set -DXO_ENABLE_OPENGL=GLFLAG [ON]
  --with-vulkan=VKFLAG    in configure step, set -DXO_ENABLE_VULKAN=VKFLAG [OFF]

  --repo                  report github repo for NAME

  --add-umbrella-remote   (in umbrella sandbox) add remote for xo library NAME
  --split-umbrella-remote (in umbrella sandbox) generate split branch for xo library NAME
  --pull-umbrella-remote  (in umbrella sandbox) pull satellite remote for xo library NAME
  --push-umbrella-remote  (in umbrella sandbox) push satellite remote for xo library NAME

EOF
}

cmd=
noop_flag=0
quiet_flag=0
xoname=
clone_flag=0
configure_flag=0
build_flag=0
build_docs_flag=0
utest_flag=0
install_flag=0
clobber_flag=0
pathtosource=
pathtobuild=
jobs_arg=
with_examples=0
with_utests=0
with_asm=0
debug_build=0
with_opengl=
with_vulkan=
repo_flag=0
add_umbrella_remote_flag=0
split_umbrella_remote_flag=0
pull_umbrella_remote_flag=0
push_umbrella_remote_flag=0
all_flag=0
with_deps_flag=0
keep_going_flag=0
sweep_flag=0
xonames=()

# --sweep re-invokes this script twice, so it needs the argv it was given.
# Captured before parsing consumes it.
orig_argv=("$@")

# everything after a literal `--`: extra arguments for the cmake CONFIGURE
# command line.  Kept as an array, not a string, so a single argument may
# contain spaces -- `-DCMAKE_CXX_FLAGS=-DA -DB` is one argument to cmake and
# has to stay one here.
cmake_extra_args=()

# --keep-going bookkeeping.  failed_subsys/skipped_subsys drive the end-of-run
# summary; skip_set maps a subsystem to the failed subsystem it is downstream
# of, so a skip can say what it was skipped for.
failed_subsys=()
skipped_subsys=()
declare -A skip_set=()

# subsystems whose --utest phase found zero tests.  Tracked because ctest exits
# 0 in that case, so they would otherwise be counted as passes.
no_tests_subsys=()

# subsystems where every requested phase succeeded and, if --utest was among
# them, at least one test ran.  Counted rather than derived, so that the
# end-of-run summary states the pass count instead of leaving the reader to
# subtract -- a subtraction that silently stops being right the moment the
# buckets overlap.
ok_subsys=()

while [[ $# > 0 ]]; do
    case "$1" in
        -u | --usage)
            cmd='usage'
            ;;
        -h | --help)
            cmd='help'
            ;;
        -n | --dry-run)
            noop_flag=1
            ;;
        -q | --quiet)
            quiet_flag=1
            ;;
        -k | --keep-going)
            keep_going_flag=1
            ;;
        -S)
            shift
            pathtosource=$1
            ;;
        -S=*)
            pathtosource="${1#*=}"
            ;;
        -B)
            shift
            pathtobuild=$1
            ;;
        -B=*)
            pathtobuild="${1#*=}"
            ;;
        -j)
            shift
            jobs_arg=$1
            ;;
        -j=*)
            jobs_arg="${1#*=}"
            ;;
        --jobs)
            shift
            jobs_arg=$1
            ;;
        --jobs=*)
            jobs_arg="${1#*=}"
            ;;
        --list)
            cmd='list'
            ;;
        --all)
            all_flag=1
            ;;
        --sweep)
            sweep_flag=1
            ;;
        --with-deps)
            with_deps_flag=1
            ;;
        --xoname=*)
            xoname="${1#*=}"
            xonames+=("${1#*=}")
            ;;
        --clone)
            clone_flag=1
            ;;
        --configure|--config)
            configure_flag=1
            ;;
        --build)
            build_flag=1
            ;;
        --build-docs)
            build_docs_flag=1
            ;;
        --utest)
            utest_flag=1
            ;;
        --install)
            install_flag=1
            ;;
        --clobber)
            clobber_flag=1
            ;;
        --with-examples)
            with_examples=1
            ;;
        --with-utests)
            with_utests=1
            ;;
        --with-asm)
            with_asm=1
            ;;
        --debug-build)
            debug_build=1
            ;;
        --with-opengl=*)
            with_opengl="${1#*=}"
            ;;
        --with-vulkan=*)
            with_vulkan="${1#*=}"
            ;;
        --repo)
            repo_flag=1
            ;;
        --add-umbrella-remote)
            add_umbrella_remote_flag=1
            ;;
        --split-umbrella-remote)
            split_umbrella_remote_flag=1
            ;;
        --pull-umbrella-remote)
            pull_umbrella_remote_flag=1
            ;;
        --push-umbrella-remote)
            push_umbrella_remote_flag=1
            ;;
        xo-*)
            xoname="$1"
            xonames+=("$1")
            ;;
        --)
            # everything after this is for cmake, verbatim.  Same convention as
            # xo-reconfigure.  NB `break`, not `;;` + shift: the loop must stop
            # here or a cmake argument that looks like one of ours (say
            # -DCMAKE_BUILD_TYPE=Debug) would be parsed as ours.
            shift
            cmake_extra_args=("$@")
            break
            ;;
        *)
            usage
            exit 1
            ;;
    esac

    shift
done

#echo xoname=$xoname pathtosource=$pathtosource pathtobuild=$pathtobuild

# -S/-B overrides (if given) apply per-subsystem below; when empty the
# source/build dirs are derived from each subsystem name in the loop.
orig_pathtosource="$pathtosource"
orig_pathtobuild="$pathtobuild"

# compile parallelism (jobs passed to cmake --build -j).  Precedence:
#   1. -j N / --jobs=N command-line argument
#   2. XO_BUILD_JOBS environment variable
#   3. memory-aware default (below)
#
# A bare "cmake --build -j" passes a no-count -j to make, which runs UNLIMITED
# parallel jobs.  On a template-heavy subsystem (e.g. xo-expression2's ~49 facet
# translation units, ~300MB each) that OOM-kills cc1plus on a memory-limited
# runner (symptom: "g++: fatal error: Killed signal terminated program cc1plus").
# So the default caps the job count to what RAM allows (~1.5GB budget per job),
# bounded by cpu count.
if [[ -n "${jobs_arg}" ]]; then
    build_jobs="${jobs_arg}"
elif [[ -n "${XO_BUILD_JOBS:-}" ]]; then
    build_jobs="${XO_BUILD_JOBS}"
else
    build_ncpu=$(nproc 2>/dev/null || echo 1)
    build_memkb=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null || echo 0)
    if [[ "${build_memkb}" -gt 0 ]]; then
        build_memjobs=$(( build_memkb / 1500000 ))   # ~1.5GB per compile job
        [[ "${build_memjobs}" -lt 1 ]] && build_memjobs=1
        if [[ "${build_memjobs}" -lt "${build_ncpu}" ]]; then
            build_jobs="${build_memjobs}"
        else
            build_jobs="${build_ncpu}"
        fi
    else
        build_jobs="${build_ncpu}"
    fi
fi

SUBSYSTEMLIST_FILE=@CMAKE_INSTALL_FULL_DATADIR@/etc/xo/subsystem-list
SUBSYSTEMEDGES_FILE=@CMAKE_INSTALL_FULL_DATADIR@/etc/xo/subsystem-edges

subsystem_list() {
    cat ${SUBSYSTEMLIST_FILE}
}

XO_REPO_STEM=
if [[ $(whoami) == "roland" ]]; then
    XO_REPO_STEM="git@github.com:Rconybea"
else
    XO_REPO_STEM="https://github.com/Rconybea"
fi

printrepo() {
    xoname=$1

    if grep -q $1 ${SUBSYSTEMLIST_FILE}; then
        echo "${XO_REPO_STEM}/${1}.git"
    else
        >&2 echo "$0: unknown xo component [${xoname}]"
        return 1
    fi

    return 0
}

if [[ $cmd == 'usage' ]]; then
    echo -n "usage: "
    usage
    exit 0
elif [[ $cmd == 'help' ]]; then
    echo -n "help; "
    help
    exit 0
fi

set -e

if [[ $cmd == 'list' ]]; then
    subsystem_list
fi

# Extra cmake arguments are consumed by the configure phase and nowhere else.
# Refuse rather than ignore them: a flag that is silently dropped produces a
# build that looks like the one you asked for and is not, which is the failure
# mode this script's -q and -k flags both exist to prevent.
if [[ ${#cmake_extra_args[@]} -gt 0 \
          && ${configure_flag} -eq 0 && ${sweep_flag} -eq 0 ]]; then
    >&2 echo "$0: arguments after -- are for the cmake configure command line," \
         "but neither --configure nor --sweep was given:" \
         "${cmake_extra_args[*]}"
    exit 1
fi

# --- --sweep: the whole-tree verification recipe -------------------------
#
# Two invocations of this script, not one pass with every phase flag set.
# xo-build runs all chosen phases for a subsystem before moving to the next,
# so a single pass would run xo-alloc's tests before xo-object had been
# configured.  Separating them also means stage 2 tests a tree that is fully
# built and installed, and gives two answers instead of one interleaved log:
# does it build, then does it pass.
#
# The flags below are the reason this exists.  Each has been forgotten at
# least once, and each failure was silent:
#   --with-examples  examples are where a refactor breaks first; a sweep
#                    without them reports green on a tree that does not build
#   --with-utests    without it cmake registers no tests and ctest is happy
#   -q               rather than >/dev/null, which discards the diagnostics
#                    and makes a failed build look exactly like a clean one
#   -k               so one broken subsystem does not hide the state of the
#                    other sixty
#
if [[ ${sweep_flag} -eq 1 ]]; then
    # replay our own argv, minus --sweep, so -j/-n/--debug-build and friends
    # reach both stages.  Stop at `--`: those arguments are re-appended last,
    # below, since each stage adds flags of its own and they must not land on
    # the far side of the separator.
    # --clobber is dropped here too, and re-added to stage 1 only.  This is
    # load-bearing, not tidiness: --clobber is legal on its own, so forwarding
    # it to stage 2 would delete every build directory and then run ctest
    # against nothing.  Whenever a flag is replayed into both stages, ask what
    # it does to a tree that is already built.
    sweep_argv=()
    for sweep_arg in ${orig_argv[@]+"${orig_argv[@]}"}; do
        [[ "${sweep_arg}" == "--" ]] && break
        case "${sweep_arg}" in
            --sweep|--clobber) ;;
            *) sweep_argv+=("${sweep_arg}") ;;
        esac
    done

    sweep_stage1=(-q -k --with-utests --with-examples --configure --build --install)
    if [[ ${clobber_flag} -eq 1 ]]; then
        sweep_stage1+=(--clobber)
    fi

    # `-- ARGS` for the sub-invocations, empty when none were given
    sweep_tail=()
    if [[ ${#cmake_extra_args[@]} -gt 0 ]]; then
        sweep_tail=(-- "${cmake_extra_args[@]}")
    fi

    # whole tree unless the caller named subsystems.  NB this runs before the
    # --all expansion below, so xonames still holds only explicit names.
    if [[ ${#xonames[@]} -eq 0 && ${all_flag} -eq 0 ]]; then
        sweep_argv+=(--all)
    fi

    # XO_ENABLE_VULKAN defaults OFF (xo-cmake/cmake/xo_macros/xo_cxx.cmake),
    # and xo-imgui's ex3/ex4/ex4a are gated on it -- so a sweep that does not
    # ask for it compiles two of five examples and still reports xo-imgui ok.
    # That is the same species of silent under-coverage as --with-examples
    # above; see .xo-backlog/xo-imgui/issues/03.
    #
    # Enabled by capability rather than by hostname: on a machine without
    # vulkan, find_package(Vulkan REQUIRED) in xo-imgui/src/imgui/CMakeLists.txt
    # would turn a green sweep red.  An explicit --with-vulkan always wins,
    # including --with-vulkan=OFF.
    if [[ -z ${with_vulkan} ]]; then
        if [[ -n ${VULKAN_SDK:-} ]] || pkg-config --exists vulkan 2>/dev/null; then
            sweep_argv+=(--with-vulkan=ON)
            >&2 echo "xo-build: --sweep: vulkan available, adding --with-vulkan=ON" \
                     "(pass --with-vulkan=OFF to override)"
        else
            >&2 echo "xo-build: --sweep: no vulkan found;" \
                     "xo-imgui examples ex3/ex4/ex4a will not be compiled"
        fi
    fi

    sweep_build_rc=0
    sweep_utest_rc=0

    >&2 echo "xo-build: --sweep stage 1 of 2: configure, build, install"
    "$0" ${sweep_argv[@]+"${sweep_argv[@]}"} \
         "${sweep_stage1[@]}" \
         ${sweep_tail[@]+"${sweep_tail[@]}"} \
        || sweep_build_rc=1

    # Stage 2 runs even when stage 1 failed.  With --keep-going a single bad
    # subsystem does not invalidate the other sixty, and skipping the whole
    # test sweep for it would discard exactly the signal --keep-going exists
    # to preserve.  The banner below says which stage failed, so a partial
    # result cannot be read as a full one.
    >&2 echo "xo-build: --sweep stage 2 of 2: utest"
    "$0" ${sweep_argv[@]+"${sweep_argv[@]}"} -q -k --utest \
        || sweep_utest_rc=1

    if [[ ${sweep_build_rc} -ne 0 && ${sweep_utest_rc} -ne 0 ]]; then
        >&2 echo "xo-build: --sweep FAILED in both stages (build and utest)"
    elif [[ ${sweep_build_rc} -ne 0 ]]; then
        >&2 echo "xo-build: --sweep FAILED in stage 1 (build);" \
             "stage 2 ran anyway, against a partly-built tree"
    elif [[ ${sweep_utest_rc} -ne 0 ]]; then
        >&2 echo "xo-build: --sweep FAILED in stage 2 (utest); the tree builds"
    else
        >&2 echo "xo-build: --sweep ok (build and utest)"
    fi

    if [[ ${sweep_build_rc} -ne 0 || ${sweep_utest_rc} -ne 0 ]]; then
        exit 1
    fi

    exit 0
fi

# resolve the set of subsystems to operate on.
#   --all           -> every subsystem in dependency order (bottom-up),
#                      excluding the xo-cmake bootstrap itself
#   one/more NAMEs  -> exactly those, in the order given
if [[ $all_flag -eq 1 ]]; then
    mapfile -t xonames < <(subsystem_list | grep -v '^xo-cmake$')
fi

# --with-deps: expand the named subsystems to their transitive dependency
# closure (via subsystem-edges), then order the closure bottom-up using
# subsystem-list (itself a valid topological order).  No effect together with
# --all (already the whole graph) or when no subsystem is named.
if [[ $with_deps_flag -eq 1 && $all_flag -eq 0 && ${#xonames[@]} -gt 0 ]]; then
    if [[ ! -r "${SUBSYSTEMEDGES_FILE}" ]]; then
        >&2 echo "$0: --with-deps: cannot read edges file ${SUBSYSTEMEDGES_FILE}"
        exit 1
    fi

    # deps_of[dependent] = space-separated direct dependencies.
    # each edge line is "<dep> <dependent>".
    declare -A deps_of=()
    while read -r edge_dep edge_dependent; do
        [[ -z "$edge_dep" || -z "$edge_dependent" ]] && continue
        deps_of["$edge_dependent"]+=" $edge_dep"
    done < "${SUBSYSTEMEDGES_FILE}"

    # transitive closure of the requested subsystems (worklist to fixpoint)
    declare -A in_closure=()
    worklist=("${xonames[@]}")
    while [[ ${#worklist[@]} -gt 0 ]]; do
        cur="${worklist[0]}"
        worklist=("${worklist[@]:1}")
        [[ -n "${in_closure[$cur]:-}" ]] && continue
        in_closure["$cur"]=1
        for d in ${deps_of[$cur]:-}; do
            [[ -z "${in_closure[$d]:-}" ]] && worklist+=("$d")
        done
    done

    # rebuild xonames in bottom-up (subsystem-list) order, closure members only
    xonames=()
    while IFS= read -r sub; do
        [[ -n "${in_closure[$sub]:-}" ]] && xonames+=("$sub")
    done < <(subsystem_list)
fi

# preserve prior single-shot no-op behavior when no subsystem is named
if [[ ${#xonames[@]} -eq 0 ]]; then
    xonames=("")
fi

# ----------------------------------------------------------------
# run one phase, honouring --quiet.
#
# Quiet means QUIET ON SUCCESS, LOUD ON FAILURE: buffer the phase's output and
# discard it only if the phase succeeded.  The contract matters more than the
# noise reduction -- the obvious alternative,
#
#     xo-build ... >/dev/null 2>&1
#
# also discards the diagnostics, so a failing build is indistinguishable from a
# passing one unless the caller separately checks $?.  If the caller then runs
# ctest, it silently tests the PREVIOUS binary.  That has actually happened
# (see .xo-backlog/xo-cmake/issues/01-xo-build-quiet-flag.md).
#
# Deliberately buffers rather than filtering cmake's output: a filter has to
# know every shape of error message, and anything it fails to match disappears.
#
# With --keep-going, a failure returns rc to the caller instead of exiting, so
# the per-subsystem loop can skip ahead; without it, behaviour is as before.
# rm -rf a build directory, with the checks that make that sentence safe.
#
# The path is computed, and -B lets the caller supply it, so `xo-build -B=/
# --clobber` is one keystroke from a very bad afternoon.  Refuse anything that
# is not a plausible build directory: empty, absolute-root-ish, or a directory
# holding no cmake artifacts.  Cheap, and the failure it prevents is unbounded.
safe_rmrf() {
    local dir="$1"

    if [[ -z "${dir}" || "${dir}" == "/" || "${dir}" == "." || "${dir}" == ".." ]]; then
        >&2 echo "xo-build: refusing to remove [${dir}]"
        exit 1
    fi

    # already gone: nothing to do, and not an error -- --clobber on a fresh
    # checkout is the normal case
    [[ -e "${dir}" ]] || return 0

    if [[ ! -d "${dir}" ]]; then
        >&2 echo "xo-build: refusing to remove [${dir}]: not a directory"
        exit 1
    fi

    # A cmake build directory always has one of these.  An empty directory is
    # fine (a configure that failed early leaves one); a directory with other
    # people's files in it is not.
    if [[ -n "$(ls -A "${dir}")" \
              && ! -e "${dir}/CMakeCache.txt" \
              && ! -d "${dir}/CMakeFiles" \
              && ! -e "${dir}/rebootcmake" ]]; then
        >&2 echo "xo-build: refusing to remove [${dir}]:" \
             "not empty and does not look like a cmake build directory" \
             "(no CMakeCache.txt, CMakeFiles/ or rebootcmake)"
        exit 1
    fi

    rm -rf "${dir}"
}

run_phase() {
    local label="$1"; shift

    local log rc

    if [[ ${quiet_flag} -eq 0 ]]; then
        set +e
        "$@"
        rc=$?
        set -e
    else
        log=$(mktemp "${TMPDIR:-/tmp}/xo-build-XXXXXX")

        set +e
        "$@" > "${log}" 2>&1
        rc=$?
        set -e

        if [[ ${rc} -ne 0 ]]; then
            >&2 echo "xo-build: ${label} FAILED for [${xoname:-.}] (exit ${rc}); output follows:"
            >&2 cat "${log}"
        fi

        rm -f "${log}"
    fi

    if [[ ${rc} -ne 0 ]]; then
        [[ ${keep_going_flag} -eq 1 ]] && return ${rc}
        exit ${rc}
    fi

    return 0
}

# --keep-going: everything downstream of a failed subsystem cannot build against
# it, so drop those rather than reporting cascade failures.  This is `make -k`.
#
# NB xo-deps -q, never 2>/dev/null: exit 2 is "no such subsystem" and exit 1 is
# "no dependents", and hiding stderr makes them indistinguishable -- a typo
# would then read as "nothing depends on this" and quietly under-skip.  Any
# non-zero exit means DO NOT PRUNE: attempting too much surfaces as ordinary
# build errors, where skipping too much leaves a silent gap.
prune_dependents() {
    local failed="$1"
    local deps rc sub

    [[ -z "${failed}" ]] && return 0

    if ! command -v xo-deps > /dev/null 2>&1; then
        >&2 echo "xo-build: xo-deps not on PATH; not pruning dependents of [${failed}]"
        return 0
    fi

    set +e
    deps=$(xo-deps --users-of="${failed}" --format=names -q)
    rc=$?
    set -e

    if [[ ${rc} -ne 0 ]]; then
        >&2 echo "xo-build: could not determine dependents of [${failed}] (xo-deps exit ${rc}); not pruning"
        return 0
    fi

    while IFS= read -r sub; do
        [[ -z "${sub}" || "${sub}" == "${failed}" ]] && continue
        skip_set["${sub}"]="${failed}"
    done <<< "${deps}"

    return 0
}

# record a failed phase for the end-of-run summary.  prune=1 for phases whose
# failure invalidates dependents (configure/build/install); 0 for --utest, where
# a dependent's tests are independent and still worth running.
note_failure() {
    local phase="$1" prune="$2"

    failed_subsys+=("${xoname:-.} (${phase})")

    [[ ${prune} -eq 1 ]] && prune_dependents "${xoname}"

    return 0
}

# --- per-subsystem operations (loop body is intentionally left un-indented) ---
for xoname in "${xonames[@]}"; do

# --keep-going: skip anything downstream of a subsystem that already failed.
# Checked here rather than pruned from xonames in place, because an explicitly
# named list is taken in the order given -- only --all/--with-deps rebuild it
# bottom-up -- so a dependent may appear before its dependency.
if [[ -n "${xoname}" && -n "${skip_set[${xoname}]:-}" ]]; then
    skipped_subsys+=("${xoname} (depends on ${skip_set[${xoname}]})")
    >&2 echo "xo-build: ${xoname} SKIPPED (depends on failed ${skip_set[${xoname}]})"
    continue
fi

# ops actually performed for this subsystem, for the --quiet summary line
phases_done=()

# set by the --utest phase when ctest reported zero tests; consumed by the
# end-of-loop tally
this_no_tests=0

if [[ -n "$orig_pathtosource" ]]; then
    pathtosource="$orig_pathtosource"
else
    pathtosource="$xoname"
fi

if [[ -n "$orig_pathtobuild" ]]; then
    pathtobuild="$orig_pathtobuild"
elif [[ -n "$xoname" ]]; then
    pathtobuild="$xoname/.build"
else
    pathtobuild=".build"
fi

if [[ $repo_flag -eq 1 ]]; then
    if [[ -n "$xoname" ]]; then
        printrepo $xoname
    fi
fi

if [[ $add_umbrella_remote_flag -eq 1 ]]; then
    if [[ $clone_flag -eq 1 || $configure_flag -eq 1 || $build_flag -eq 1 || $build_docs_flag -eq 1 || $install_flag -eq 1 || $clobber_flag -eq 1 ]]; then
        2>&1 echo "error: xo-build: repo operation --add-umbrella-remote conflicts with"
        2>&1 echo "                 build operation --clone|--clobber|--configure|--build|--build-docs|--install"
        exit 1
    fi

    if [[ -n "$xoname" ]]; then
        url=$(printrepo $xoname)

        cmd="git remote add $xoname $url"

        if [[ $noop_flag -eq 1 ]]; then
            echo $cmd
        else
            $cmd
        fi
    fi
fi

if [[ $split_umbrella_remote_flag -eq 1 ]]; then
    if [[ -n "$xoname" ]]; then
        #branch=$(git branch --show-current)
        demux_branch=_demux/$xoname
        cmd="git subtree split --rejoin --prefix=$xoname -b ${demux_branch}"

        if [[ $noop_flag -eq 1 ]]; then
            echo $cmd
        else
            $cmd
        fi
    fi
fi

if [[ $pull_umbrella_remote_flag -eq 1 ]]; then
    if [[ -n "$xoname" ]]; then
        branch=$(git branch --show-current)
        cmd="git subtree pull --rejoin --prefix=$xoname $xoname ${branch}"

        if [[ $noop_flag -eq 1 ]]; then
            echo $cmd
        else
            $cmd
        fi
    fi
fi

if [[ $push_umbrella_remote_flag -eq 1 ]]; then
    if [[ -n "$xoname" ]]; then
        branch=$(git branch --show-current)
        demux_branch=_demux/$xoname
        cmd1="git subtree split --rejoin --prefix=$xoname -b ${demux_branch}"
        remote=${xoname}
        remote_branch=${branch}
        cmd2="git push ${remote} ${demux_branch}:${remote_branch}"
        #cmd="git subtree push --rejoin --prefix=$xoname $xoname ${branch}"

        if [[ $noop_flag -eq 1 ]]; then
            echo $cmd1
            echo $cmd2
        else
            $cmd1
            $cmd2
        fi
    fi
fi

if [[ $clone_flag -eq 1 ]]; then
    if [[ -n "$xoname" ]]; then
        url=$(printrepo $xoname)

        cmd="git clone $url $xoname"

        if [[ $noop_flag -eq 1 ]]; then
            echo $cmd
        else
            $cmd
        fi
    fi
fi

# --clobber: discard the build directory.  FIRST in the phase order, so that
# `--clobber --configure` reads as "start over" -- which is the whole point.
# Same flag name and meaning as xo-reconfigure --clobber.
#
# It supersedes --realclean, which was identical except for running LAST, so
# `--realclean --configure --build` configured, built, then deleted the result.
# Nothing in the tree ever called it (checked 2026-08-10: zero occurrences
# outside this file, in CI, docs or scripts), so it was removed rather than
# kept as an alias -- an alias would silently reverse the ordering for anyone
# who did depend on the old behaviour, where removal fails loudly.
#
# This is the supported way to drop cached cmake state.  Stickiness is a cmake
# feature, not a bug -- variables persist so you need not re-state them -- and
# the way to opt out is to discard the cache, not to fight it variable by
# variable.  `-- '-DCMAKE_CXX_FLAGS='` clears one entry you know the name of;
# --clobber is what you want when you do not.
if [[ $clobber_flag -eq 1 ]]; then
    if [[ $noop_flag -eq 1 ]]; then
        echo "rm -rf $pathtobuild"
    else
        safe_rmrf "${pathtobuild}"
        phases_done+=(clobber)
    fi
fi

if [[ $configure_flag -eq 1 ]]; then
    if [[ -n "$xoname" ]]; then
        testingarg=
        if [[ $with_utests -eq 1 ]]; then
            testingarg="-DENABLE_TESTING=1"
        fi

        asmarg=
        if [[ $with_asm -eq 1 ]]; then
            asmarg="-DENABLE_ASM=1"
        fi

        examplearg=
        if [[ $with_examples -eq 1 ]]; then
            examplearg="-DXO_ENABLE_EXAMPLES=1"
        fi

        cmakebuildtype=
        if [[ $debug_build -eq 1 ]]; then
            cmakebuildtype="-DCMAKE_BUILD_TYPE=Debug"
        fi

        openglarg=
        if [[ -n ${with_opengl} ]]; then
            openglarg="-DXO_ENABLE_OPENGL=${with_opengl}"
        fi

        vulkanarg=
        if [[ -n ${with_vulkan} ]]; then
            vulkanarg="-DXO_ENABLE_VULKAN=${with_vulkan}"
        fi

        cmd="cmake -DCMAKE_INSTALL_PREFIX=@CMAKE_INSTALL_PREFIX@ -DCMAKE_MODULE_PATH=@CMAKE_INSTALL_PREFIX@/share/cmake -S $pathtosource -B $pathtobuild ${testingarg} ${examplearg} ${asmarg} ${openglarg} ${vulkanarg} ${cmakebuildtype}"

        # `-- ARGS`, shell-quoted, for the places that need the command as text
        # (the dry run, and the rebootcmake script).  ${cmd} itself is a string
        # relied on for word-splitting; the extra arguments are NOT, so that one
        # argument containing spaces survives as one argument.  They go last, so
        # a caller can override anything set above -- cmake takes the final -D
        # for a given variable.
        extra_str=
        if [[ ${#cmake_extra_args[@]} -gt 0 ]]; then
            extra_str=$(printf ' %q' "${cmake_extra_args[@]}")
        fi

        if [[ $noop_flag -eq 1 ]]; then
            echo "$cmd${extra_str}"
        else
            cwd=$(pwd)
            # write script to re-run cmake later
            rebootcmake=$pathtobuild/rebootcmake

            mkdir -p $(dirname ${rebootcmake})

            cat > ${rebootcmake} <<EOF
#!/usr/bin/env bash

cd ${cwd} && ${cmd}${extra_str}

EOF
            chmod +rx ${rebootcmake}

            run_phase configure $cmd ${cmake_extra_args[@]+"${cmake_extra_args[@]}"} \
                || { note_failure configure 1; continue; }
            phases_done+=(configure)
        fi
    fi
fi

if [[ $build_flag -eq 1 ]]; then
    if [[ -n "$xoname" ]]; then
        cmd="cmake --build $pathtobuild -j$build_jobs"

        if [[ $noop_flag -eq 1 ]]; then
            echo $cmd
        else
            run_phase build $cmd || { note_failure build 1; continue; }
            phases_done+=(build)
        fi
    fi
fi

if [[ $build_docs_flag -eq 1 ]]; then
    if [[ -n "$xoname" ]]; then
        cmd="cmake --build $pathtobuild -- docs"

        if [[ $noop_flag -eq 1 ]]; then
            echo $cmd
        else
            $cmd
        fi
    fi
fi

if [[ $utest_flag -eq 1 ]]; then
    if [[ -n "$xoname" ]]; then
        cmd="ctest --test-dir $pathtobuild"

        if [[ $noop_flag -eq 1 ]]; then
            echo $cmd
        else
            # A subsystem with no tests at all must NOT report plain "ok":
            # ctest exits 0 on "No tests were found!!!", so a sweep would count
            # it as a pass and overstate coverage.  On this tree that is 26 of
            # 61 subsystems -- enough to make a summary line actively
            # misleading.  Same defect as .xo-backlog/nix-packaging (packages
            # built without -DENABLE_TESTING ran zero tests and looked green).
            #
            # Counted with `ctest -N`, which executes nothing and reports
            # "Total Tests: N".  That is ctest's own structured summary, not an
            # error-message shape, so this is not the kind of output-filtering
            # ticket 01 argues against.  If the count cannot be parsed we fall
            # through and run the tests: doing the work is the safe direction,
            # claiming "no tests" wrongly is not.
            utest_n=$(ctest --test-dir "$pathtobuild" -N 2>&1 \
                          | sed -n 's/^Total Tests: \([0-9][0-9]*\)$/\1/p' | tail -1)

            if [[ "${utest_n}" == "0" ]]; then
                # NB no `continue` here: having no tests is not a failure, so
                # later phases (--install) and the per-subsystem summary line
                # must still happen.
                #
                # Recorded as a flag, not appended to no_tests_subsys here:
                # a later phase may still fail, and the end-of-run buckets
                # (ok / no tests / failed / skipped) have to stay disjoint if
                # they are to add up to the number of subsystems attempted.
                # The append happens at the end of the loop body, which is
                # reached only when every phase succeeded.
                this_no_tests=1
                phases_done+=("utest:no-tests")

                if [[ ${quiet_flag} -eq 0 ]]; then
                    echo "xo-build: ${xoname:-.} has no tests"
                fi
            else
                # On failure, re-run just the failed tests verbosely so CI logs show
                # WHY they failed -- the first pass reports only pass/fail per test,
                # whereas --output-on-failure prints each failed test's output (e.g.
                # the Catch2 assertion detail).  Preserve the failing exit status so
                # the build still fails.
                # quiet buffers the pass/fail summary; the rerun below is the
                # interesting output and always goes to the terminal.
                utest_rc=0
                if [[ ${quiet_flag} -eq 1 ]]; then
                    utest_log=$(mktemp "${TMPDIR:-/tmp}/xo-build-utest-XXXXXX")
                    set +e; $cmd > "${utest_log}" 2>&1; utest_rc=$?; set -e
                    [[ ${utest_rc} -ne 0 ]] && cat "${utest_log}" 1>&2
                    rm -f "${utest_log}"
                else
                    set +e; $cmd; utest_rc=$?; set -e
                fi

                if [[ ${utest_rc} -ne 0 ]]; then
                    echo "xo-build: unit tests failed for [${xoname:-.}] -- re-running failures with --rerun-failed --output-on-failure" 1>&2
                    ctest --test-dir "$pathtobuild" --rerun-failed --output-on-failure || true

                    # --keep-going does NOT prune here (note_failure ... 0): a test
                    # failure does not invalidate a dependent's tests.  The
                    # dependent built fine, and its tests exercise different code,
                    # so skipping it would discard real signal.  Contrast the build
                    # phases, where a dependent cannot build at all.
                    #
                    # The `continue` DOES skip this subsystem's remaining phases
                    # (i.e. --install), which is deliberate: do not install a
                    # subsystem whose tests just failed.
                    note_failure utest 0
                    [[ ${keep_going_flag} -eq 1 ]] && continue
                    exit 1
                fi
                phases_done+=(utest)
            fi
        fi
    fi
fi

if [[ $install_flag -eq 1 ]]; then
    if [[ -n "$xoname" ]]; then
        cmd="cmake --install $pathtobuild"

        if [[ $noop_flag -eq 1 ]]; then
            echo $cmd
        else
            run_phase install $cmd || { note_failure install 1; continue; }
            phases_done+=(install)
        fi
    fi
fi

# --quiet: one line per subsystem, so a long --all run still shows progress.
# Reaching here means every phase succeeded for this subsystem: without
# --keep-going run_phase exits on the first failure, and with it the call sites
# `continue` past this line.
if [[ ${quiet_flag} -eq 1 && ${#phases_done[@]} -gt 0 ]]; then
    echo "xo-build: ${xoname:-.} ok (${phases_done[*]})"
fi

# end-of-run tallies.  Every subsystem that gets here succeeded, so it lands in
# exactly one of ok / no-tests; the failed and skipped buckets are filled by
# note_failure and the skip check at the top of the loop, both of which
# `continue` before this point.  Disjoint by construction, which is what lets
# the summary line add up to the number attempted.
if [[ ${#phases_done[@]} -gt 0 ]]; then
    if [[ ${this_no_tests} -eq 1 ]]; then
        no_tests_subsys+=("${xoname:-.}")
    else
        ok_subsys+=("${xoname:-.}")
    fi
fi

done

# --- end-of-run summary (--keep-going only) -------------------------------
#
# Always report skipped subsystems as skipped.  Reporting only failures would
# let a partial run read as a full one -- the same defect this flag exists to
# fix, one level down.
if [[ ${keep_going_flag} -eq 1 ]]; then
    if [[ ${#failed_subsys[@]} -gt 0 \
              || ${#skipped_subsys[@]} -gt 0 \
              || ${#no_tests_subsys[@]} -gt 0 ]]; then
        >&2 echo "xo-build: --keep-going summary:"

        for entry in "${failed_subsys[@]:-}"; do
            [[ -n "${entry}" ]] && >&2 echo "  FAILED   ${entry}"
        done

        for entry in "${skipped_subsys[@]:-}"; do
            [[ -n "${entry}" ]] && >&2 echo "  skipped  ${entry}"
        done

        # Reported even on an otherwise clean run, and deliberately not folded
        # into the pass count: "60 ok" reads as much stronger evidence than
        # "34 ok, 26 with no tests".
        if [[ ${#no_tests_subsys[@]} -gt 0 ]]; then
            >&2 echo "  no tests ${no_tests_subsys[*]}"
        fi
    fi

    # Printed even when nothing went wrong: on a clean run this line is the
    # whole result, and "61 attempted: 61 ok" is a claim you can quote,
    # whereas silence is indistinguishable from a run that did nothing.
    #
    # The four buckets are disjoint and cover every subsystem attempted, so
    # they add up -- which is the point.  Stating `ok` rather than leaving it
    # to be derived also removes the standing invitation to subtract wrongly:
    # "34 ok" used to be arrived at as 61 - 26 - 1 by hand.
    >&2 echo "xo-build: ${#xonames[@]} attempted:" \
         "${#ok_subsys[@]} ok," \
         "${#no_tests_subsys[@]} with no tests," \
         "${#failed_subsys[@]} failed," \
         "${#skipped_subsys[@]} skipped"

    # NB an `if`, not `[[ ... ]] && exit 1`: as the last statement in the script
    # the latter returns 1 when the condition is FALSE, so a clean --keep-going
    # run would exit non-zero.
    if [[ ${#failed_subsys[@]} -gt 0 ]]; then
        exit 1
    fi
fi

exit 0
