@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

#
# Libwebsockets arrives via find_package().
# xo_export_cmake_config() only knows about xo deps
# Other external packages Libwebsockets needs must list here also
find_dependency(Libwebsockets)
# jsoncpp_lib is in websock's INTERFACE_LINK_LIBRARIES.
find_dependency(jsoncpp CONFIG)

@XO_FIND_DEPENDENCY_BLOCK@

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Share.cmake")
check_required_components("@PROJECT_NAME@")
