/* @file pyobject2.hpp
 *
 * automatically generated from src/pyobject2/pyobject2.hpp.in
 * see src/pyobject2/CMakeLists.txt
 */

/* The module's python name is xo.object2, but its init symbol is NOT: CPython
 * looks for PyInit_<last dotted component>, so PYBIND11_MODULE() takes the
 * bare name.  The `xo.` prefix comes from the directory the .so is emitted
 * into -- see xo_pybind11_library() in xo-cmake.
 *
 * example:
 *   PYBIND11_MODULE(PYOBJECT2_MODULE_NAME(), m) { ... }
 */
#define PYOBJECT2_MODULE_NAME() @SELF_MODULE@

/* the qualified name, for importing.
 * example:
 *   py::module_::import(PYOBJECT2_MODULE_NAME_STR)
 */
#define PYOBJECT2_MODULE_NAME_STR "@SELF_QUALNAME@"

/* example:
 *   PYOBJECT2_IMPORT_MODULE()
 * replaces
 *   py::module_::import("xo.object2")
 */
#define PYOBJECT2_IMPORT_MODULE() py::module_::import("@SELF_QUALNAME@")

/* end pyobject2.hpp */
